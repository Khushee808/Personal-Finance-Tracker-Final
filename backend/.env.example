# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=personal_finance_tracker
# Change this to a long random private value before use
JWT_SECRET=replace_with_a_long_random_secret_value
PORT=5000
FLASK_DEBUG=false
# Set these only for creating the first admin; run python create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_12_chars_minimum
